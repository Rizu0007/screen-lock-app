# Postgres started by `docker compose up -d`
DATABASE_URL=postgres://app:app@localhost:5434/screenlock

# Server-side secret mixed into every Argon2 hash (password + PIN).
# Generate with: openssl rand -base64 48
# Changing it invalidates all stored hashes. Required; the app refuses to start without it.
AUTH_PEPPER=change-me-to-a-long-random-string-at-least-32-chars

# Optional. Max Postgres connections per server instance (default 10, or 5 on Vercel).
# DATABASE_POOL_MAX=5

# Demo/assessment deployments only: seed the demo accounts during the Vercel
# build and show their credentials on the login page. Never enable for real users.
# SEED_DEMO_ACCOUNTS=true
